---
import { u } from "../lib/url";
/* /story — testimony/autobiography chapters; thread scroll-dot is in Base layout. */
import Base from "../layouts/Base.astro";

const chapters = [
  { id: "origins", title: "Where it began" },
  { id: "brokenness", title: "The breaking" },
  { id: "grace", title: "Grace" },
  { id: "becoming", title: "Becoming" },
  { id: "today", title: "Today" },
];
---

<Base
  title="The testimony and autobiography of Tejas Kumar"
  description="The thread: the testimony and autobiography of Tejas Kumar — chapters from his life and story."
  current="/story"
  routeName="/story"
>
  <nav aria-label="Breadcrumb" class="crumb">
    <a href={u("/")}>Tejas Kumar</a><span aria-hidden="true">/</span><span aria-current="page">Story</span>
  </nav>

  <header class="page-head">
    <h1 class="text-colossal">The thread.</h1>
    <p class="text-lede lede">
      The testimony and autobiography of Tejas Kumar — the thread that runs
      through it all.
    </p>
  </header>

  <div class="story-body">
    {chapters.map((ch, i) => (
      <section class="chapter" id={ch.id} aria-labelledby={`${ch.id}-h`}>
        <p class="text-micro chapter-num" aria-hidden="true">Chapter {i + 1}</p>
        <h2 id={`${ch.id}-h`} class="text-minor">{ch.title}</h2>
        <div class="placeholder" role="note" aria-label={`Chapter ${i + 1} content placeholder`}>
          <p class="text-label">[CONTENT PLACEHOLDER — chapter text not in evidence package]</p>
        </div>
      </section>
    ))}
  </div>
</Base>

<style>
  .crumb {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: var(--track-micro);
    text-transform: uppercase;
    color: var(--fg-3);
    display: flex;
    gap: 0.75rem;
    align-items: center;
    padding: 2.5rem 1.5rem 0;
    max-width: 72rem;
    margin: 0 auto;
  }
  .crumb a { color: var(--fg-3); }
  .crumb a:hover { color: var(--accent); }
  .page-head {
    max-width: 72rem;
    margin: 0 auto;
    padding: 2rem 1.5rem 4rem;
  }
  .page-head h1 { margin: 0 0 1.5rem; }
  .lede { max-width: 42rem; color: var(--fg-2); }
  .story-body {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 1.5rem 6rem;
  }
  .chapter {
    padding: 5rem 0;
    border-top: 1px solid var(--hairline);
    min-height: 60vh;
  }
  .chapter-num { color: var(--accent); margin-bottom: 1rem; }
  .chapter h2 { margin: 0 0 2rem; }
  .placeholder {
    border: 1px dashed var(--hairline-lit);
    border-radius: 0.75rem;
    padding: 4rem 1.5rem;
    background: var(--bg-plate);
    text-align: center;
    color: var(--fg-3);
  }
</style>
