---
import { u } from "../../lib/url";
/* /demos/tavus — Tavus video AI demo embed region (static reproduction). */
import Base from "../../layouts/Base.astro";
---

<Base
  title="Tavus Video AI Demo with Live Tool Calls in the Browser"
  description="A Tavus video AI demo with live tool calls in the browser — a face that calls my functions."
  current="/demos/tavus"
  routeName="/demos/tavus"
>
  <nav aria-label="Breadcrumb" class="crumb">
    <a href={u("/")}>Tejas Kumar</a><span aria-hidden="true">/</span><a href={u("/demos/tavus")}>Demos</a><span aria-hidden="true">/</span><span aria-current="page">Tavus</span>
  </nav>

  <header class="page-head">
    <h1 class="text-major">A face that calls my functions.</h1>
    <p class="text-lede lede">
      A Tavus video AI demo with live tool calls, right in the browser.
    </p>
  </header>

  <section aria-labelledby="demo" class="demo-section">
    <h2 id="demo" class="text-minor visually-hidden">Interactive demo</h2>
    <div class="embed-region">
      <div class="placeholder" role="note" aria-label="Demo embed placeholder">
        <p class="text-label">[DEMO PLACEHOLDER — interactive demo runtime not exercised]</p>
        <p class="text-small">
          The live Tavus demo requires a browser session with camera and API
          credentials; it is represented here as a static region.
        </p>
      </div>
    </div>
  </section>

  <section aria-labelledby="about-demo">
    <h2 id="about-demo" class="text-minor">About this demo</h2>
    <p class="text-body">
      This demo pairs a real-time video AI persona with live tool calls: the
      face on screen can invoke functions exposed by the page, turning a
      conversation into actions.
    </p>
  </section>
</Base>

<style>
  .crumb {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: var(--track-micro);
    text-transform: uppercase;
    color: var(--fg-3);
    display: flex; gap: 0.75rem; align-items: center;
    padding: 2.5rem 1.5rem 0; max-width: 72rem; margin: 0 auto;
  }
  .crumb a { color: var(--fg-3); }
  .crumb a:hover { color: var(--accent); }
  .page-head { max-width: 72rem; margin: 0 auto; padding: 2rem 1.5rem 3rem; }
  .page-head h1 { margin: 0 0 1.5rem; }
  .lede { max-width: 42rem; color: var(--fg-2); }
  section { max-width: 72rem; margin: 0 auto; padding: 2.5rem 1.5rem; border-top: 1px solid var(--hairline); }
  section h2:not(.visually-hidden) { margin: 0 0 1.5rem; }
  section p { max-width: 46rem; color: var(--fg-2); }
  .embed-region {
    aspect-ratio: 16 / 9;
    border: 1px solid var(--hairline);
    border-radius: 1rem;
    background: var(--bg-plate);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .placeholder { text-align: center; color: var(--fg-3); padding: 2rem; max-width: 34rem; }
  .placeholder .text-label { margin-bottom: 1rem; }
  .placeholder .text-small { color: var(--fg-3); }
  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
</style>
