---
import { u } from "../../lib/url";
/* /blog/[slug] — PostHero + TOC + prose (excerpt + placeholder) + share + FAQ + related. */
import Base from "../../layouts/Base.astro";
import content from "../../data/content.json";

export function getStaticPaths() {
  return content.blog.map((post, i) => ({
    params: { slug: post.slug },
    props: { post, index: i },
  }));
}

const { post, index } = Astro.props;
const posts = content.blog;
const total = posts.length;
const related = [posts[(index - 1 + total) % total], posts[(index + 1) % total], posts[(index + 2) % total]].filter(
  (p) => p.slug !== post.slug
);

const fmt = (d: string) =>
  new Date(d).toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });

const postUrl = `https://tej.as/blog/${post.slug}`;
const shareX = `https://x.com/intent/post?url=${encodeURIComponent(postUrl)}&text=${encodeURIComponent(post.title)}`;
const shareBluesky = `https://bsky.app/intent/compose?text=${encodeURIComponent(`${post.title} ${postUrl}`)}`;
const shareLinkedIn = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(postUrl)}`;
---

<Base
  title={`${post.title} | Tejas Kumar`}
  description={post.description}
  current="/blog"
  routeName="/blog/[slug]"
>
  <nav aria-label="Breadcrumb" class="crumb">
    <a href={u("/")}>Tejas Kumar</a><span aria-hidden="true">/</span><a href={u("/blog")}>Blog</a><span aria-hidden="true">/</span><span aria-current="page">{post.title}</span>
  </nav>

  <article class="post">
    <header class="post-hero">
      <p class="text-micro post-date">{fmt(post.date)}</p>
      <h1 class="text-major">{post.title}</h1>
      <p class="text-lede post-excerpt">{post.description}</p>
    </header>

    <nav aria-labelledby="post-toc-label" class="toc">
      <h2 id="post-toc-label" class="text-label">On this page</h2>
      <ol>
        <li><a href="#overview">Overview</a></li>
        <li><a href="#full-text">Full text</a></li>
        <li><a href="#questions">Questions</a></li>
      </ol>
    </nav>

    <div class="prose" id="overview">
      <p class="text-body">{post.description}</p>
      <div class="placeholder" role="note" aria-label="Full article text placeholder" id="full-text">
        <p class="text-label">[CONTENT PLACEHOLDER — full text not in evidence package]</p>
      </div>
    </div>

    <aside aria-label="Share this post" class="share">
      <h2 class="text-label">Share this post</h2>
      <ul>
        <li><a href={shareX} target="_blank" rel="noopener" aria-label="Share this post on X">X</a></li>
        <li><a href={shareBluesky} target="_blank" rel="noopener" aria-label="Share this post on Bluesky">Bluesky</a></li>
        <li><a href={shareLinkedIn} target="_blank" rel="noopener" aria-label="Share this post on LinkedIn">LinkedIn</a></li>
      </ul>
    </aside>

    <section aria-labelledby="questions" class="faq">
      <h2 id="questions" class="text-minor">Questions</h2>
      <details class="faq-item">
        <summary class="text-body">What is this post about?</summary>
        <p class="text-small">{post.description}</p>
      </details>
      <details class="faq-item">
        <summary class="text-body">When was it written?</summary>
        <p class="text-small">{fmt(post.date)}</p>
      </details>
      <details class="faq-item">
        <summary class="text-body">Where can I read the full text?</summary>
        <p class="text-small">
          The full text isn't part of this reproduction — read the original on{" "}
          <a href={postUrl} target="_blank" rel="noopener">tej.as</a>.
        </p>
      </details>
    </section>

    <section aria-labelledby="related" class="related">
      <h2 id="related" class="text-minor">Related posts</h2>
      <ul class="related-list">
        {related.map((r) => (
          <li>
            <a href={u(`/blog/${r.slug}`)}>
              <span class="text-micro related-date">{fmt(r.date)}</span>
              <span class="text-body related-title">{r.title}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <div
      role="slider"
      tabindex="0"
      aria-label="Scrub through this post"
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="0"
      class="scrub"
      data-scrub
    >
      <span class="scrub__hint text-micro">Scrub through this post</span>
      <span class="scrub__track" aria-hidden="true"><span class="scrub__fill" data-scrub-fill></span></span>
    </div>
  </article>

  <script is:inline>
    // Keyboard scrubber: arrow keys scroll the page, slider value tracks progress.
    (function () {
      var scrub = document.querySelector("[data-scrub]");
      if (!scrub) return;
      var fill = scrub.querySelector("[data-scrub-fill]");
      function update() {
        var max = document.documentElement.scrollHeight - window.innerHeight;
        var pct = max > 0 ? Math.round((window.scrollY / max) * 100) : 0;
        scrub.setAttribute("aria-valuenow", String(pct));
        if (fill) fill.style.width = pct + "%";
      }
      window.addEventListener("scroll", update, { passive: true });
      scrub.addEventListener("keydown", function (e) {
        var step = window.innerHeight * 0.2;
        if (e.key === "ArrowDown" || e.key === "ArrowRight") { window.scrollBy(0, step); e.preventDefault(); }
        else if (e.key === "ArrowUp" || e.key === "ArrowLeft") { window.scrollBy(0, -step); e.preventDefault(); }
        else if (e.key === "Home") { window.scrollTo(0, 0); e.preventDefault(); }
        else if (e.key === "End") { window.scrollTo(0, document.documentElement.scrollHeight); e.preventDefault(); }
        update();
      });
      update();
    })();
  </script>
</Base>

<style>
  .crumb {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: var(--track-micro);
    text-transform: uppercase;
    color: var(--fg-3);
    display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap;
    padding: 2.5rem 1.5rem 0; max-width: 72rem; margin: 0 auto;
  }
  .crumb a { color: var(--fg-3); }
  .crumb a:hover { color: var(--accent); }
  .post { max-width: 72rem; margin: 0 auto; padding: 0 1.5rem 6rem; }
  .post-hero { padding: 2rem 0 3rem; max-width: 52rem; }
  .post-date { color: var(--fg-3); margin: 0 0 1.25rem; }
  .post-hero h1 { margin: 0 0 1.5rem; }
  .post-excerpt { color: var(--fg-2); }
  .toc {
    border: 1px solid var(--hairline); border-radius: 0.75rem;
    padding: 1.5rem; background: var(--bg-plate); max-width: 32rem; margin-bottom: 2.5rem;
  }
  .toc h2 { margin: 0 0 1rem; color: var(--fg-3); }
  .toc ol { margin: 0; padding-left: 1.25rem; }
  .toc li { padding: 0.25rem 0; }
  .prose { max-width: 46rem; padding-bottom: 2.5rem; }
  .prose p { color: var(--fg-2); }
  .placeholder {
    border: 1px dashed var(--hairline-lit); border-radius: 0.75rem;
    padding: 4rem 1.5rem; background: var(--bg-plate);
    text-align: center; color: var(--fg-3); margin-top: 2rem;
  }
  .share { border-top: 1px solid var(--hairline); padding: 2rem 0; max-width: 46rem; }
  .share h2 { margin: 0 0 1rem; color: var(--fg-3); }
  .share ul { list-style: none; margin: 0; padding: 0; display: flex; gap: 0.75rem; }
  .share a {
    display: inline-block; padding: 0.6rem 1.25rem; border: 1px solid var(--hairline-lit);
    border-radius: 999px; text-decoration: none; color: var(--fg);
    font-family: var(--font-mono); font-size: var(--t-label);
    letter-spacing: var(--track-label); text-transform: uppercase;
  }
  .share a:hover { border-color: var(--accent); color: var(--accent); }
  .faq { border-top: 1px solid var(--hairline); padding: 2.5rem 0; max-width: 46rem; }
  .faq h2 { margin: 0 0 1.5rem; }
  .faq-item { border-bottom: 1px solid var(--hairline); padding: 1.25rem 0; }
  .faq-item summary { cursor: pointer; font-weight: var(--w-mid); }
  .faq-item p { color: var(--fg-3); margin: 0.75rem 0 0; }
  .related { border-top: 1px solid var(--hairline); padding: 2.5rem 0; }
  .related h2 { margin: 0 0 1.5rem; }
  .related-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 1px; background: var(--hairline); border: 1px solid var(--hairline); border-radius: 0.75rem; overflow: hidden; }
  .related-list li { background: var(--bg); }
  .related-list a { display: block; padding: 1.25rem 1.5rem; text-decoration: none; color: inherit; }
  .related-list a:hover .related-title { color: var(--accent); }
  .related-date { color: var(--fg-3); display: block; margin-bottom: 0.5rem; }
  .related-title { font-weight: var(--w-mid); line-height: 1.35; }
  .scrub {
    margin-top: 3rem; max-width: 46rem; cursor: default;
    padding: 1rem; border: 1px solid var(--hairline); border-radius: 0.75rem;
  }
  .scrub:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
  .scrub__hint { color: var(--fg-3); display: block; margin-bottom: 0.75rem; }
  .scrub__track { display: block; height: 0.375rem; border-radius: 999px; background: var(--hairline); overflow: hidden; }
  .scrub__fill { display: block; height: 100%; width: 0; background: var(--accent); }
</style>
